# Copy to backend/.env for local development. Never commit the real .env.

# local | aws
APP_ENV=local

# --- Database -----------------------------------------------------------------
# Local: matches docker-compose.yml (throwaway local-only credentials).
DATABASE_URL=postgresql+psycopg://crm_local:crm_local_password@localhost:5432/crm_projects
# AWS: leave DATABASE_URL empty; these are injected by template.yaml.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_SECRET_ARN=

# --- Authentication -------------------------------------------------------------
# local | cognito
AUTH_MODE=local
# Any long random string for local development, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- File storage ---------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
PUBLIC_API_URL=http://localhost:8000
S3_BUCKET_NAME=
AWS_REGION=
DOWNLOAD_URL_EXPIRES_SECONDS=300
MAX_UPLOAD_MB=5

# --- HTTP -------------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# --- Seed (local only) --------------------------------------------------------------
# Password given to the demo users created by `python -m app.migrate_handler --seed`.
SEED_DEMO_PASSWORD=Password123!
