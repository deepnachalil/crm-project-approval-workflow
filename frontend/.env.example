# Copy to frontend/.env.local for local development. Never commit real values.

# Base URL of the backend API (local uvicorn, or the API Gateway stage URL on AWS).
VITE_API_BASE_URL=http://localhost:8000

# local | cognito  (must match the backend AUTH_MODE)
VITE_AUTH_MODE=local

# Only used when VITE_AUTH_MODE=cognito (public identifiers, not secrets).
VITE_COGNITO_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
